gartner-hypecycle-graph: 1
# A hand-authored hype cycle of large language models and agentic development, from word
# embeddings to ideas that have not started yet. Dates after 2026 are projections, and dates and
# influences are illustrative, not a claim: see readme.md.
trends:
  - id: word-embeddings
    name: Word embeddings
    start: 2013-01
    stop: 2021-01
    row: 0
    phases: 4
    tags: [language]
    description: word2vec turned words into vectors whose arithmetic meant something.
  - id: attention
    name: Sequence-to-sequence with attention
    start: 2014-09
    stop: 2020-01
    row: 2
    phases: 4
    tags: [language, architecture]
  - id: transformer
    name: Transformer
    start: 2017-06
    stop: 2026-01
    row: 4
    phases: 4
    tags: [architecture]
    description: Attention Is All You Need, the architecture under every model that followed.
  - id: pretrained-encoders
    name: Pretrained encoders
    start: 2018-10
    stop: 2024-01
    row: 6
    phases: 4
    tags: [language]
    description: BERT and its family, fine-tuned for one task at a time.
  - id: scaling-laws
    name: Scaling laws
    start: 2020-01
    stop: 2030-01
    row: 2
    phases: 3
    peak-end: 2024-11
    trough-end: 2025-09
    tags: [models]
    description: Loss falls predictably with parameters, data and compute; talk of a wall followed in late 2024.
  - id: mixture-of-experts
    name: Mixture of experts
    start: 2021-01
    stop: 2030-01
    row: 0
    phases: 3
    tags: [architecture, models]
  - id: large-language-models
    name: Large language models
    start: 2020-06
    stop: 2034-01
    row: 8
    phases: 3
    peak-end: 2023-06
    trough-end: 2025-01
    tags: [models]
    description: From GPT-3 on, language became a general interface to computing.
  - id: instruction-tuning
    name: Instruction tuning and RLHF
    start: 2022-01
    stop: 2030-01
    row: 10
    phases: 3
    tags: [models, alignment]
    description: Human feedback turned a text predictor into something that follows instructions.
  - id: image-generation
    name: Image generation
    start: 2022-04
    stop: 2031-01
    row: 12
    phases: 3
    tags: [multimodal]
    description: Diffusion models drew what a prompt described.
  - id: chat-assistants
    name: Chat assistants
    start: 2022-11
    stop: 2034-01
    row: 14
    phases: 2
    peak-end: 2025-06
    tags: [products]
    description: ChatGPT reached a hundred million users in two months.
  - id: alignment-research
    name: Alignment research
    start: 2022-12
    stop: 2036-01
    row: 16
    phases: 2
    tags: [alignment, society]
    description: Constitutional AI, interpretability and evaluations, so that models do what people mean.
  - id: open-weight-models
    name: Open-weight models
    start: 2023-02
    stop: 2033-01
    row: 18
    phases: 2
    tags: [models]
    description: From LLaMA to DeepSeek, weights anyone can download and run.
  - id: multimodal-models
    name: Multimodal models
    start: 2023-03
    stop: 2033-01
    row: 20
    phases: 2
    tags: [multimodal, models]
  - id: world-models
    name: World models
    start: 2024-02
    stop: 2036-01
    row: 22
    phases: 1
    tags: [multimodal, models]
    description: Models that simulate how a scene unfolds, from video generation to robot training.
  - id: small-models
    name: Small on-device models
    start: 2024-04
    stop: 2032-01
    row: 24
    phases: 1
    tags: [models]
  - id: reasoning-models
    name: Reasoning models
    start: 2024-09
    stop: 2034-01
    row: 26
    phases: 1
    tags: [models]
    description: Spending compute at answer time on a chain of thought, from OpenAI's o1 on.
  - id: retrieval-augmented-generation
    name: Retrieval-augmented generation
    start: 2020-05
    stop: 2031-01
    row: 28
    phases: 3
    tags: [tooling]
    description: Fetch the relevant documents first, then let the model answer from them.
  - id: ai-code-completion
    name: AI code completion
    start: 2021-06
    stop: 2030-01
    row: 30
    phases: 3
    tags: [coding]
    description: GitHub Copilot completed the line, then the function.
  - id: vector-databases
    name: Vector databases
    start: 2021-06
    stop: 2030-01
    row: 32
    phases: 3
    tags: [tooling, data]
  - id: prompt-engineering
    name: Prompt engineering
    start: 2022-06
    stop: 2029-01
    row: 34
    phases: 3
    peak-end: 2023-06
    trough-end: 2024-06
    tags: [techniques]
    description: Once a job title; now context engineering, part of every developer's work.
  - id: tool-use
    name: Tool use and function calling
    start: 2023-06
    stop: 2031-01
    row: 36
    phases: 3
    peak-end: 2024-06
    trough-end: 2025-06
    tags: [agents, tooling]
  - id: model-context-protocol
    name: Model Context Protocol
    start: 2024-11
    stop: 2032-01
    row: 38
    phases: 1
    tags: [agents, tooling]
    description: One protocol for connecting any model to any tool or data source.
  - id: autonomous-agents
    name: Autonomous agents
    start: 2023-03
    stop: 2034-01
    row: 40
    phases: 3
    peak-end: 2023-08
    trough-end: 2025-01
    tags: [agents]
    description: AutoGPT looped a model on its own output; the loops worked once models and tools caught up.
  - id: multi-agent-systems
    name: Multi-agent systems
    start: 2023-10
    stop: 2034-01
    row: 42
    phases: 2
    peak-end: 2025-10
    tags: [agents]
    description: Agents with roles handing work to one another.
  - id: computer-use-agents
    name: Computer-use agents
    start: 2024-10
    stop: 2034-01
    row: 44
    phases: 1
    tags: [agents]
    description: Agents that read the screen and move the mouse.
  - id: coding-agents
    name: Coding agents
    start: 2025-02
    stop: 2035-01
    row: 46
    phases: 1
    tags: [agents, coding]
    description: Agents that read a repository, run its tests and open the pull request.
  - id: vibe-coding
    name: Vibe coding
    start: 2025-02
    stop: 2028-01
    row: 48
    phases: 2
    peak-end: 2025-09
    tags: [coding, society]
    description: Accepting whatever the model writes without reading it; the name is Andrej Karpathy's.
  - id: agent-to-agent-protocols
    name: Agent-to-agent protocols
    start: 2025-04
    stop: 2034-01
    row: 50
    phases: 1
    tags: [agents, upcoming]
  - id: spec-driven-development
    name: Spec-driven development
    start: 2025-09
    stop: 2034-01
    row: 52
    phases: 1
    tags: [coding, agents]
    description: Specifications, plans and tasks as the contract between people and coding agents, as GitHub Spec Kit does.
  - id: human-agent-teams
    name: Human-agent teams
    start: 2026-06
    stop: 2038-01
    row: 54
    phases: 1
    tags: [agents, society, upcoming]
    description: People and agents sharing one workspace, one backlog and one conversation, each in a role.
  - id: autonomous-research-agents
    name: Autonomous research agents
    start: 2027-01
    stop: 2040-01
    row: 56
    phases: 1
    tags: [agents, science, conceptual]
    description: Agents that form a hypothesis, run the experiment and write it up.
  - id: continual-learning
    name: Continual learning
    start: 2027-06
    stop: 2038-01
    row: 58
    phases: 1
    tags: [models, conceptual]
    description: Models that keep learning after deployment instead of waiting for the next training run.
  - id: verified-code-generation
    name: Verified code generation
    start: 2028-01
    stop: 2040-01
    row: 60
    phases: 1
    tags: [coding, conceptual]
    description: Agents that prove what they write rather than only testing it.
  - id: agent-economies
    name: Agent economies
    start: 2029-01
    stop: 2042-01
    row: 62
    phases: 1
    tags: [agents, society, conceptual]
    description: Agents buying, selling and contracting services from one another.
  - id: recursive-self-improvement
    name: Recursive self-improvement
    start: 2031-01
    stop: 2045-01
    row: 64
    phases: 1
    tags: [models, conceptual]
    description: Systems that improve the systems that improve them.
triggers:
  - id: alexnet
    name: AlexNet wins ImageNet
    date: 2012-09
    row: 1
    tags: [models]
    description: Deep networks trained on GPUs became the default approach to learning from data.
  - id: attention-is-all-you-need
    name: Attention Is All You Need
    date: 2017-06
    row: 3
    tags: [architecture]
    description: The paper that introduced the Transformer.
  - id: gpt-3-paper
    name: GPT-3 paper
    date: 2020-05
    row: 7
    tags: [models]
    description: A 175-billion-parameter model that learned tasks from a few examples in its prompt.
  - id: chatgpt-launch
    name: ChatGPT launched
    date: 2022-11
    row: 13
    tags: [products]
    description: A hundred million users in two months.
  - id: llama-weights
    name: LLaMA weights released
    date: 2023-02
    row: 17
    tags: [models]
    description: Meta's model weights, shared with researchers and leaked within a week.
  - id: eu-ai-act
    name: EU AI Act enters into force
    date: 2024-08
    row: 15
    tags: [society, alignment]
    description: The first broad law on AI, with duties for general-purpose models.
  - id: deepseek-r1
    name: DeepSeek-R1 released
    date: 2025-01
    row: 25
    tags: [models]
    description: An open-weight reasoning model trained at a fraction of the expected cost.
