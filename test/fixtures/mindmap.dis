{
  "$schema": "https://etalii.net/adp/disl/schema/0.2/disl.schema.json#/$defs/Specification",
  "disl": "0.3",
  "language": {
    "id": "net.etalii.adp.freeplane.mindmap",
    "version": "0.3.0",
    "origin": "freeplane/mindmap",
    "label": "Mind map",
    "doc": {
      "summary": "Ideas branching from one central topic, for thinking a subject through rather than specifying it.",
      "description": "A mind map is a tree of topics around one central topic. Its first-level branches go to the left and the right of the centre; every deeper branch grows away from the centre. The diagram is stored in the Freeplane `.mm` format (FreeMind-compatible), so Freeplane and FreeMind can open what ADP writes and ADP can open what they write, with everything ADP does not understand preserved byte for byte.\n\nWhat this specification cannot express - the `.mm` format and the persistence plugin that reads it, the two-sided layout, sibling naming, the link picker and the drag-to-re-parent gesture - is described in `mindmap.md` beside this file.",
      "tags": [
        "mind map",
        "mindmap",
        "freeplane",
        "freemind",
        "knowledge",
        "brainstorming"
      ],
      "seeAlso": [
        {
          "title": "Freeplane",
          "href": "https://www.freeplane.org/"
        },
        {
          "title": "Freeplane example maps",
          "href": "https://www.freeplane.org/wiki/index.php/Gallery"
        }
      ]
    },
    "authors": [
      {
        "name": "Peter Vrenken",
        "url": "https://github.com/vrenken"
      }
    ],
    "license": "Apache-2.0",
    "homepage": "https://etalii.net/adp",
    "icon": "mdi-family-tree",
    "fileExtension": "mm"
  },
  "functions": {
    "siblingName": {
      "params": [
        {
          "name": "names",
          "type": "list(string)"
        }
      ],
      "returns": "string",
      "cel": "'Node'",
      "doc": "The name for a new node among siblings with `names`. This body is the fallback only; ADP continues a numbered run ('Phase 1', 'Phase 2' -> 'Phase 3', one past the highest) or a shared last word ('Measure pass', 'Arrange pass' -> 'New pass'), and makes the result unique. The full rule is in mindmap.md."
    },
    "indicators": {
      "params": [
        {
          "name": "n",
          "type": "Element"
        }
      ],
      "returns": "string",
      "cel": "[n.notes != '' ? '\u2022' : '', n.link != '' ? '\u2197' : '', n.view.collapsed && n.children.size() > 0 ? '\u2295' : ''].join(' ').trim()",
      "doc": "The corner glyphs of a node: \u2022 it has notes, \u2197 it links somewhere (an empty link draws none), \u2295 its branch is collapsed for this viewer. The three are joined by single spaces before the ends are trimmed, so a node with notes and a collapsed branch but no link reads `\u2022  \u2295`, two spaces apart, as the canvas has always drawn it."
    },
    "fileBase": {
      "params": [
        {
          "name": "file",
          "type": "string"
        }
      ],
      "returns": "string",
      "cel": "file.trim().lowerAscii().endsWith('.adp') ? file.trim().substring(0, file.trim().size() - 4) : file.trim()",
      "doc": "The name a finding calls the map by: the file it is attributed to (its `.adp` registration, else the `.mm` itself) without the registration's `.adp`."
    }
  },
  "metamodel": {
    "doc": "One node type, nested to any depth. The tree is containment: every node but the central topic has exactly one parent node, and the order of a node's children is meaningful and stored.",
    "enums": {
      "Side": {
        "doc": "Freeplane's `POSITION` attribute on a first-level node: which side of the central topic the branch is drawn on. Freeplane 1.11 wrote `left`/`right`; 1.12 writes `top_or_left`/`bottom_or_right`. Both vocabularies are read; ADP never writes the attribute.",
        "values": {
          "right": {
            "label": "Right (Freeplane 1.11)"
          },
          "left": {
            "label": "Left (Freeplane 1.11)"
          },
          "bottom_or_right": {
            "label": "Right (Freeplane 1.12)"
          },
          "top_or_left": {
            "label": "Left (Freeplane 1.12)"
          }
        }
      }
    },
    "types": {
      "Node": {
        "label": "Node",
        "icon": "mdi-card-plus-outline",
        "doc": {
          "summary": "A topic in the map. The one node without a parent is the central topic.",
          "description": "Stored as a Freeplane `<node>` element. Its `ID` is the element id (`ID_` plus a short id for nodes ADP creates). A node with no `ID` in the file is given one in memory on open and written on the next save, never on open. Two nodes the file gives one `ID` are both read; the first keeps the id and the later ones are reported by `mindmap.duplicate-id`."
        },
        "attributes": {
          "text": {
            "type": "string",
            "label": "Text",
            "default": "",
            "doc": {
              "summary": "The node's text.",
              "description": "Stored in the `TEXT` attribute, or - for formatted text - as the HTML body of a `richcontent TYPE=\"NODE\"` child, read as plain text with one line per paragraph. Any text is valid, the empty string included. Setting the text writes plain `TEXT` and drops the formatted body."
            },
            "order": 1
          },
          "notes": {
            "type": "text",
            "markup": "plain",
            "label": "Notes",
            "default": "",
            "doc": {
              "summary": "Free-form notes on the node.",
              "description": "Stored as the HTML body of a `richcontent TYPE=\"NOTE\"` child, one `<p>` per line. Emptying the notes removes the `richcontent` element."
            },
            "order": 2
          },
          "link": {
            "type": "string",
            "label": "Link",
            "doc": {
              "summary": "What the node links to: a file or folder in the project, or a URL.",
              "description": "Stored in the `LINK` attribute exactly as Freeplane defines it: a path relative to the map file (forward slashes), or an absolute URL. A file link is picked from the project's files, never typed, and never resolves outside the project. An empty `LINK=\"\"` is a stored link with no target: the node offers Change link and Unlink, and draws no link glyph."
            },
            "order": 3
          },
          "folded": {
            "type": "bool",
            "label": "Collapsed",
            "readOnly": true,
            "default": false,
            "group": "View",
            "doc": {
              "summary": "Whether the file says this branch starts collapsed.",
              "description": "Freeplane's `FOLDED=\"true\"`. It seeds each viewer's own collapsed state when the map opens (`persistence.view.initial`); collapsing and expanding afterwards is viewer state that is never written to the file and never lands on the undo history. The Collapsed row shows this flag, not the viewer's state.",
              "rationale": "Two people viewing one map fold independently."
            },
            "order": 4
          },
          "position": {
            "type": "Side",
            "label": "Side",
            "readOnly": true,
            "doc": "Freeplane's `POSITION` on a first-level node, when the file has one. Honoured by the layout; never written by ADP.",
            "order": 5
          }
        },
        "children": {
          "allowed": [
            "Node"
          ],
          "ordered": true
        },
        "labelAttribute": "text"
      }
    },
    "relations": {
      "Branch": {
        "label": "Branch",
        "doc": {
          "summary": "The line from a node to its parent.",
          "description": "Not a stored relation: a branch is derived from containment, one per node that has a parent. It cannot be selected, created, reconnected or deleted on its own; re-parenting a node moves its branch."
        },
        "source": "Node",
        "target": "Node",
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": false,
        "derived": {
          "from": "diagram.nodes.filter(n, n.parent != null)",
          "source": "item.parent",
          "target": "item",
          "doc": "One branch per node with a parent, from the parent to the node. Containment already rules out a cycle, so the relation states no `acyclic` of its own."
        }
      }
    }
  },
  "coordinates": {
    "doc": "One free pixel canvas without grid or snapping. The central topic's centre is the origin; every position is computed by the layout.",
    "systems": {
      "canvas": {
        "kind": "cartesian",
        "x": {
          "kind": "linear",
          "unit": "px"
        },
        "y": {
          "kind": "linear",
          "unit": "px"
        },
        "orientation": "y-down",
        "grid": {
          "visible": false
        }
      }
    },
    "default": "canvas"
  },
  "notation": {
    "theme": {
      "tokens": {
        "color.surface": "#FFFFFF",
        "color.border": "#E2E8F0",
        "color.text": "#0F172A",
        "color.primary": "limegreen",
        "font.body": "system-ui, sans-serif"
      },
      "modes": {
        "dark": {
          "color.surface": "#1E293B",
          "color.border": "#334155",
          "color.text": "#F1F5F9"
        }
      },
      "defaultMode": "light",
      "followSystem": true
    },
    "styles": {
      "node": {
        "fill": {
          "token": "color.surface"
        },
        "stroke": {
          "color": {
            "token": "color.border"
          },
          "width": 1.5
        },
        "font": {
          "family": {
            "token": "font.body"
          },
          "size": 12,
          "color": {
            "token": "color.text"
          }
        },
        "padding": [
          6,
          10
        ],
        "cursor": "pointer"
      },
      "branch": {
        "stroke": {
          "color": {
            "token": "color.border"
          },
          "width": 1.5
        }
      }
    },
    "shapes": {
      "topicBox": {
        "label": "Topic box",
        "doc": "A rectangle with corners rounded by 6, as an SVG `rect` with `rx` 6 draws it: each radius is at most half its side, so a box narrower or lower than 12 has elliptical corners. The node's position is its centre (`placement.anchor`).",
        "path": {
          "segments": [
            {
              "op": "M",
              "x": "min(6.0, w / 2.0)",
              "y": 0
            },
            {
              "op": "L",
              "x": "w - min(6.0, w / 2.0)",
              "y": 0
            },
            {
              "op": "A",
              "rx": "min(6.0, w / 2.0)",
              "ry": "min(6.0, h / 2.0)",
              "rotation": 0,
              "largeArc": false,
              "sweep": true,
              "x": "w",
              "y": "min(6.0, h / 2.0)"
            },
            {
              "op": "L",
              "x": "w",
              "y": "h - min(6.0, h / 2.0)"
            },
            {
              "op": "A",
              "rx": "min(6.0, w / 2.0)",
              "ry": "min(6.0, h / 2.0)",
              "rotation": 0,
              "largeArc": false,
              "sweep": true,
              "x": "w - min(6.0, w / 2.0)",
              "y": "h"
            },
            {
              "op": "L",
              "x": "min(6.0, w / 2.0)",
              "y": "h"
            },
            {
              "op": "A",
              "rx": "min(6.0, w / 2.0)",
              "ry": "min(6.0, h / 2.0)",
              "rotation": 0,
              "largeArc": false,
              "sweep": true,
              "x": 0,
              "y": "h - min(6.0, h / 2.0)"
            },
            {
              "op": "L",
              "x": 0,
              "y": "min(6.0, h / 2.0)"
            },
            {
              "op": "A",
              "rx": "min(6.0, w / 2.0)",
              "ry": "min(6.0, h / 2.0)",
              "rotation": 0,
              "largeArc": false,
              "sweep": true,
              "x": "min(6.0, w / 2.0)",
              "y": 0
            },
            {
              "op": "Z"
            }
          ]
        }
      }
    },
    "nodes": {
      "Node": {
        "shape": "topicBox",
        "style": "node",
        "size": {
          "min": [
            32,
            31.6
          ],
          "autoSize": "fitContent",
          "resizable": false
        },
        "placement": {
          "x": {
            "layout": true
          },
          "y": {
            "layout": true
          },
          "anchor": "center",
          "movable": true,
          "resizable": false,
          "doc": "Positions come from the layout. A node can be dragged: dropping it on another node makes it that node's last child, and dropping it on empty canvas does nothing. The drag never writes a position."
        },
        "labels": [
          {
            "id": "text",
            "text": {
              "attribute": "text"
            },
            "editable": "inline",
            "position": "center",
            "wrap": "none"
          },
          {
            "id": "indicators",
            "text": {
              "cel": "indicators(self)"
            },
            "visible": {
              "cel": "indicators(self) != ''"
            },
            "position": {
              "anchor": [
                1,
                0
              ],
              "offset": [
                -4,
                12
              ],
              "align": "end"
            },
            "doc": "The corner glyphs (`indicators`), right-aligned 4 inside the right edge, 12 below the top."
          }
        ],
        "anchors": {
          "mode": "sides",
          "sides": [
            "left",
            "right"
          ]
        },
        "container": {
          "layout": "layout:mindmap",
          "clip": false,
          "collapsible": true,
          "highlightOnDrop": true
        },
        "states": {
          "dragging": {
            "opacity": 0.65
          },
          "dropTarget": {
            "stroke": {
              "color": {
                "token": "color.primary"
              },
              "width": 2.5,
              "dash": [
                6,
                3
              ],
              "dashScale": "absolute"
            }
          }
        },
        "deletable": {
          "cel": "self.parent != null"
        },
        "doubleClick": "none",
        "doc": "A box with rounded corners sized to its text, the text centred and the corner glyphs top right. A double-click does nothing of its own; the text is edited in place through Rename (F2). A branch leaves and reaches a node at the middle of its left or right side."
      }
    },
    "edges": {
      "Branch": {
        "line": {
          "stroke": {
            "color": {
              "token": "color.border"
            },
            "width": 1.5
          },
          "routing": "bezier",
          "bendpoints": {
            "editable": false
          },
          "startDirection": "auto",
          "endDirection": "auto"
        },
        "style": "branch",
        "sourceMarker": "none",
        "targetMarker": "none",
        "anchoring": {
          "source": {
            "mode": "sides"
          },
          "target": {
            "mode": "sides"
          }
        },
        "selectable": false,
        "deletable": false,
        "reconnectable": false,
        "layer": "belowNodes",
        "doc": "A smooth curve from the facing side of the parent to the facing side of the child, under the boxes, with no arrowheads."
      }
    },
    "canvas": {
      "background": {
        "token": "color.surface"
      }
    }
  },
  "toolbox": {
    "doc": "One tool: a node, dropped on the node that becomes its parent. Everything else is on the selected node's context menu and keyboard.",
    "generic": {
      "select": true,
      "pan": true
    },
    "searchable": false,
    "groups": [
      {
        "id": "mindmap",
        "label": "Mind map",
        "tools": [
          {
            "id": "node",
            "kind": "operation",
            "operation": "addChild",
            "label": "Node",
            "icon": "mdi-card-plus-outline",
            "doc": "Drop on a node to add a child under it."
          }
        ]
      }
    ],
    "contextMenus": [
      {
        "for": [
          "Node"
        ],
        "placement": "menu",
        "standardEntries": false,
        "tools": [
          {
            "kind": "operation",
            "operation": "addChild",
            "group": "structure",
            "label": "Add child",
            "icon": "mdi-subdirectory-arrow-right",
            "shortcut": "Insert"
          },
          {
            "kind": "operation",
            "operation": "addSibling",
            "group": "structure",
            "label": "Add sibling",
            "icon": "mdi-plus",
            "shortcut": "Enter",
            "visible": "self.parent != null"
          },
          {
            "kind": "editLabel",
            "group": "structure",
            "label": "Rename\u2026",
            "icon": "mdi-pencil-outline",
            "shortcut": "F2"
          },
          {
            "kind": "delete",
            "group": "structure",
            "label": "Delete",
            "icon": "mdi-trash-can-outline",
            "shortcut": "Delete",
            "visible": "self.parent != null"
          },
          {
            "kind": "operation",
            "operation": "editNotes",
            "group": "content",
            "label": {
              "cel": "self.notes != '' ? 'Edit notes\u2026' : 'Add notes\u2026'"
            },
            "icon": "mdi-note-text-outline"
          },
          {
            "kind": "operation",
            "operation": "link",
            "group": "content",
            "label": {
              "cel": "has(self.link) ? 'Change link\u2026' : 'Link to\u2026'"
            },
            "icon": "mdi-link-variant"
          },
          {
            "kind": "operation",
            "operation": "unlink",
            "group": "content",
            "label": "Unlink",
            "icon": "mdi-link-variant-off",
            "visible": "has(self.link)"
          },
          {
            "kind": "operation",
            "operation": "toggleFold",
            "group": "view",
            "label": "Expand",
            "icon": "mdi-unfold-more-horizontal",
            "shortcut": "Space",
            "visible": "self.children.size() > 0 && self.view.collapsed"
          },
          {
            "kind": "operation",
            "operation": "toggleFold",
            "group": "view",
            "label": "Collapse",
            "icon": "mdi-unfold-less-horizontal",
            "shortcut": "Space",
            "visible": "self.children.size() > 0 && !self.view.collapsed"
          }
        ],
        "doc": "Three groups: the structure (add, rename, delete), the content (notes and link) and the view (expand or collapse). An entry that does not apply is left out rather than greyed: the central topic has no sibling and cannot be deleted, an unlinked node has nothing to unlink, a leaf has nothing to collapse. Expand and Collapse are one operation with two faces; which one shows follows this viewer's collapsed state."
      }
    ]
  },
  "forms": {
    "nodeProperties": {
      "for": "Node",
      "usage": [
        "inspector"
      ],
      "label": "Mind map node",
      "items": [
        {
          "attribute": "text",
          "widget": "text"
        },
        {
          "attribute": "notes",
          "widget": "textarea",
          "rows": 4
        },
        {
          "attribute": "link",
          "widget": "text",
          "placeholder": "Empty to unlink",
          "doc": "An emptied link is an unlink."
        },
        {
          "kind": "section",
          "title": "View",
          "items": [
            {
              "kind": "computed",
              "id": "folded",
              "label": "Collapsed",
              "value": {
                "cel": "self.folded ? 'Yes' : 'No'"
              },
              "visible": "self.children.size() > 0",
              "readOnlyReasons": [
                "Collapsing is a view setting rather than part of the document, so it is not undoable. Collapse from the canvas or the context menu."
              ],
              "doc": "The file's FOLDED flag, which seeds each viewer's collapsed state; shown only for a node with children."
            }
          ]
        },
        {
          "kind": "section",
          "title": "Model",
          "items": [
            {
              "kind": "computed",
              "id": "identifier",
              "label": "Identifier",
              "value": {
                "cel": "self.id"
              },
              "readOnlyReasons": [
                "Freeplane gives every node its identifier and other files may link to it, so it is not ours to change."
              ]
            }
          ]
        }
      ]
    }
  },
  "constraints": {
    "doc": "A map that breaks a rule still opens. A file that is not a readable map has the one finding `mindmap.not-a-map` and no other. Only the central topic is judged for text: Freeplane itself keeps ordinary nodes without text, so an empty node elsewhere is style, not a problem. A map with more than one root node is not readable at all, so it needs no rule of its own.",
    "blockSaveOn": "never",
    "order": [
      "mindmap.unnamed-root",
      "mindmap.duplicate-id"
    ],
    "builtIn": {
      "std.unparseable": {
        "code": "mindmap.not-a-map",
        "severity": "error",
        "message": {
          "cel": "\"'\" + fileBase(diagram.file) + \"' is not a readable mind map: \" + detail.reason"
        }
      },
      "std.duplicateId": {
        "enabled": false,
        "doc": "Reported by mindmap.duplicate-id, once per later holder in document order and naming both texts."
      }
    },
    "rules": [
      {
        "id": "unnamedCentralTopic",
        "code": "mindmap.unnamed-root",
        "label": "Named central topic",
        "scope": [
          "Node"
        ],
        "when": "self.parent == null",
        "rule": "self.text.trim() != ''",
        "severity": "warning",
        "suppressible": false,
        "message": {
          "cel": "\"The map '\" + fileBase(diagram.file) + \"' has an unnamed central topic.\""
        },
        "doc": {
          "summary": "The central topic should have text."
        }
      },
      {
        "id": "duplicateId",
        "code": "mindmap.duplicate-id",
        "label": "One node per id",
        "scope": [
          "Node"
        ],
        "when": "self.id != ''",
        "rule": "diagram.elementById(self.id) == self",
        "severity": "error",
        "suppressible": false,
        "message": {
          "cel": "\"Two nodes share the id '\" + self.id + \"' ('\" + diagram.elementById(self.id).text + \"' and '\" + self.text + \"').\""
        },
        "doc": {
          "summary": "Two nodes with one id would answer to each other's selections.",
          "description": "Reported on each node after the first that the file gives an id, in document order. A node the file gives no id is not judged."
        }
      },
      {
        "id": "keepCentralTopic",
        "kind": "delete",
        "scope": "Node",
        "rule": "self.parent != null",
        "message": "The root node cannot be removed."
      },
      {
        "id": "reparentWithinTree",
        "kind": "containment",
        "when": "has(child.id)",
        "rule": "child.parent != null && parent != null && parent.id != child.id && !child.descendants().exists(d, d.id == parent.id)",
        "message": "A node cannot be moved into its own branch, and the root node cannot be moved.",
        "doc": "A drop that would make a node its own ancestor, or move the central topic, is refused; the drag preview does not offer such a node as a target."
      }
    ]
  },
  "behavior": {
    "operations": {
      "addChild": {
        "label": "Add child",
        "for": [
          "Node"
        ],
        "icon": "mdi-subdirectory-arrow-right",
        "shortcut": "Insert",
        "doc": "Adds a node as the last child, named after the pattern its new siblings follow, then edits its text in place.",
        "actions": [
          {
            "create": {
              "type": "'Node'",
              "parent": "self",
              "attributes": {
                "text": "siblingName(self.children.map(c, c.text))"
              }
            },
            "as": "added"
          },
          {
            "select": "added"
          },
          {
            "editLabel": {
              "target": "added",
              "label": "text"
            }
          }
        ]
      },
      "addSibling": {
        "label": "Add sibling",
        "for": [
          "Node"
        ],
        "icon": "mdi-plus",
        "shortcut": "Enter",
        "enabled": "self.parent != null",
        "doc": "Adds a node right after this one under the same parent, named after the pattern of its siblings, then edits its text in place. The position right after this node is not expressible in the `create` action and is supplied by the runtime (see mindmap.md).",
        "actions": [
          {
            "create": {
              "type": "'Node'",
              "parent": "self.parent",
              "attributes": {
                "text": "siblingName(self.parent.children.map(c, c.text))"
              }
            },
            "as": "added"
          },
          {
            "select": "added"
          },
          {
            "editLabel": {
              "target": "added",
              "label": "text"
            }
          }
        ]
      },
      "editNotes": {
        "label": "Notes",
        "for": [
          "Node"
        ],
        "icon": "mdi-note-text-outline",
        "params": {
          "notes": {
            "type": "text",
            "label": "Notes"
          }
        },
        "actions": [
          {
            "set": {
              "notes": "p.notes"
            }
          }
        ]
      },
      "link": {
        "label": "Link to",
        "for": [
          "Node"
        ],
        "icon": "mdi-link-variant",
        "doc": "Picks a file or folder of the project from a tree and stores it relative to the map file.",
        "plugin": {
          "name": "net.etalii.adp.ide.projectLinkPicker"
        }
      },
      "unlink": {
        "label": "Unlink",
        "for": [
          "Node"
        ],
        "icon": "mdi-link-variant-off",
        "enabled": "has(self.link)",
        "actions": [
          {
            "unset": [
              "link"
            ]
          }
        ]
      },
      "toggleFold": {
        "label": {
          "cel": "self.view.collapsed ? 'Expand' : 'Collapse'"
        },
        "for": [
          "Node"
        ],
        "shortcut": "Space",
        "doc": "Collapses or expands the branch for this viewer only. View state: nothing is written and nothing lands on the undo history.",
        "enabled": "self.children.size() > 0",
        "actions": [
          {
            "view": {
              "collapsed": "!self.view.collapsed"
            }
          }
        ]
      }
    },
    "deletion": {
      "Node": {
        "children": "delete",
        "relations": "delete",
        "confirm": {
          "count": "self.descendants().size()",
          "threshold": 1,
          "title": "Delete branch?",
          "message": {
            "cel": "\"Delete '\" + self.text + \"' and the \" + string(count) + \" nodes under it? You can undo this.\""
          },
          "confirmLabel": "Delete",
          "danger": true
        },
        "doc": "Deleting a node takes its branch with it. A leaf goes without asking; a node with anything beneath it asks first, naming how many nodes go with it. Both are undoable."
      }
    },
    "clipboard": {
      "relations": "internal",
      "ids": "regenerate"
    }
  },
  "layout": {
    "algorithms": {
      "mindmap": {
        "algorithm": "plugin:net.etalii.adp.freeplane.mindmapLayout",
        "spacing": {
          "node": 10,
          "layer": 48
        },
        "options": {
          "net.etalii.adp.mindmap.minimumGapRatio": 0.1,
          "net.etalii.adp.mindmap.fontSize": 14,
          "net.etalii.adp.mindmap.lineHeight": 1.4,
          "net.etalii.adp.mindmap.horizontalPadding": 10,
          "net.etalii.adp.mindmap.verticalPadding": 6,
          "net.etalii.adp.mindmap.minimumWidth": 32
        },
        "doc": "The conventional two-sided mind map: the central topic centred at the origin, first-level branches split to its right and left, each subtree a column centred on its parent, depth as distance from the centre. Collapsed branches take no space. The algorithm is in mindmap.md."
      }
    },
    "default": "mindmap",
    "trigger": "always",
    "respect": "none",
    "incremental": false,
    "animate": false
  },
  "persistence": {
    "format": "fbl",
    "binding": "https://raw.githubusercontent.com/etalii-adp/etalii.adp.ide.standalone/develop/src/diagrams/mindmap/backend/EtAlii.Adp.Diagram.Mindmap/mindmap.fbl#mindmap",
    "ids": {
      "strategy": "uuid-v4",
      "prefix": "ID_",
      "encoding": "base36",
      "stable": true,
      "doc": "A node ADP creates gets `ID_` and a ShortGuid (a version 4 GUID as 25 characters of base 36). Freeplane's own ids (`ID_` and digits) are kept as written. A node read without an `ID` is given one in memory and written on the next save."
    },
    "view": {
      "store": [],
      "viewer": [
        "collapsed",
        "viewport"
      ],
      "initial": {
        "collapsed": {
          "cel": "self.folded"
        }
      },
      "doc": "Folding belongs to each viewer: FOLDED in the file seeds it once, and nothing a viewer folds is written."
    },
    "typeMap": {
      "Node": {
        "as": "Node",
        "hostAttributes": [
          "storedId"
        ],
        "doc": "The plugin reads a `<node>` as a Node. A later holder of an id the file gives twice is read under an ephemeral id; `storedId` keeps what the file writes, which findings name it by."
      }
    },
    "doc": "Stored as a Freeplane `.mm` file, not as JSON: the XML the map was read from is the single source of truth, edits change it in place, and an unchanged map is written back byte for byte. The binding `mindmap.fbl#mindmap` names the persistence plugin `net.etalii.adp.freeplane.mm` as its reader. The format is in mindmap.md."
  },
  "plugins": {
    "net.etalii.adp.freeplane.mm": {
      "version": "^0.1.0",
      "provides": [
        "persistenceFormat"
      ],
      "required": true,
      "doc": "Reads Freeplane `.mm` XML into nodes, for the binding `mindmap.fbl#mindmap`. Edits are made in place on the XML the map was read from, so everything the map does not change is written back byte for byte."
    },
    "net.etalii.adp.freeplane.mindmapLayout": {
      "version": "^0.1.0",
      "provides": [
        "layout"
      ],
      "required": false,
      "fallback": {
        "layout": "mrtree"
      },
      "doc": "The two-sided mind map layout."
    },
    "net.etalii.adp.ide.projectLinkPicker": {
      "version": "^0.1.0",
      "provides": [
        "action",
        "widget"
      ],
      "required": false,
      "doc": "Lets the user pick a project file or folder from a tree and stores the choice as a path relative to the map file."
    }
  },
  "x-mindmap": {
    "doc": "Today's wire ids, which the standalone client and backend share, mapped from this specification's names, as x-abm and x-ghg do. A tool is keyed by its id; an action by its entry's operation, else its kind; a property row by its form item's id, else its attribute.",
    "types": {
      "Node": "node",
      "Branch": "branch"
    },
    "tools": {
      "node": {
        "id": "mindmap.toolbox.node",
        "drop": "mindmap.add-child"
      }
    },
    "actions": {
      "addChild": "mindmap.add-child",
      "addSibling": "mindmap.add-sibling",
      "editLabel": "mindmap.rename",
      "delete": "mindmap.delete",
      "editNotes": "mindmap.edit-notes",
      "link": "mindmap.link",
      "unlink": "mindmap.unlink",
      "toggleFold": "mindmap.toggle-fold"
    },
    "properties": {
      "text": "mindmap.text",
      "notes": "mindmap.notes",
      "link": "mindmap.link",
      "folded": "mindmap.folded",
      "identifier": "mindmap.identifier"
    }
  }
}
