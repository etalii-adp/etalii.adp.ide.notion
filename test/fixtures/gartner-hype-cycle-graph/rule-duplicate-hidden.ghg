gartner-hypecycle-graph: 1
trends:
  - id: a
    name: A
    start: 1900-01
    stop: 1920-01
    row: 0
    phases: 2
  - id: b
    name: B
    start: 1910-01
    stop: 1930-01
    row: 0
    phases: 4
influences:
  - id: ab
    from: a
    from-phase: plateau
    from-edge: bottom
    from-at: 0.5
    to: b
    to-phase: peak
    to-edge: top
    to-at: 0.5
  - id: ab2
    from: a
    from-phase: peak
    from-edge: bottom
    from-at: 0.5
    to: b
    to-phase: trough
    to-edge: top
    to-at: 0.5
